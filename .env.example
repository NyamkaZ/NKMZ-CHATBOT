# Backend
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot_secret@postgres:5432/chatbot
REDIS_URL=redis://redis:6379/0
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_P=0.9
OLLAMA_NUM_PREDICT=4096
QWEN_THINKING_MODE=no_think
DAILY_MESSAGE_LIMIT=30
RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Stripe (optional — leave empty to use demo upgrade in dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
PRO_DAILY_MESSAGE_LIMIT=200
PREMIUM_DAILY_MESSAGE_LIMIT=1000

# Bots (optional)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=chatbot_verify

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
